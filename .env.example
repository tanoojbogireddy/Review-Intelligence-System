# ── RIAS Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The app works out-of-the-box WITHOUT setting anything here.

# ── LLM toggle ─────────────────────────────────────────────────────────────
# Set to "true" to use OpenAI for sentiment + category classification.
# Requires OPENAI_API_KEY to be set.
USE_LLM=false

# ── OpenAI config (only needed when USE_LLM=true) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
